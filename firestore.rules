rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // users/{uid}: profile, settings, entitlements (server), grants
    // users/{uid}/purchases/{transactionId}: server-only IAP records
    // saves/{uid}/slots/{slotId}: character blob + metadata
    // leaderboard/{seasonId}/entries/{uid}: server-written scores
    // liveops/*, liveops_history/*: server-written config
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function clientAllowedUserKeys() {
      return [
        'activeSlotId', 'displayName', 'updatedAt', 'profile', 'settings',
        'coinsGrant', 'gemsGrant', 'luckBoostGrant', 'reincarnationScroll',
      ];
    }

    function validOptionalEquippedId(settings, key) {
      return !(key in settings)
        || settings[key] == null
        || (settings[key] is string
          && settings[key].size() >= 1
          && settings[key].size() <= 64);
    }

    function validProfile() {
      return request.resource.data.profile is map
        && request.resource.data.profile.displayName is string
        && request.resource.data.profile.displayName.size() >= 1
        && request.resource.data.profile.displayName.size() <= 64
        && (!('avatarUrl' in request.resource.data.profile)
          || (request.resource.data.profile.avatarUrl is string
            && request.resource.data.profile.avatarUrl.size() <= 512))
        && (
          request.resource.data.profile.keys().hasOnly(['displayName', 'createdAt'])
          || request.resource.data.profile.keys().hasOnly(['displayName', 'createdAt', 'avatarUrl'])
        );
    }

    function validSettings() {
      return request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly([
          'colorScheme', 'appThemeId', 'notificationsEnabled',
          'soundEnabled', 'musicEnabled', 'hapticsEnabled',
          'masterVolume', 'musicVolume',
          'equippedEventSkinId', 'equippedNameFontId', 'equippedSoundPackId',
          'equippedProfileFrameId', 'equippedTombstoneId',
        ])
        && (!('colorScheme' in request.resource.data.settings)
          || request.resource.data.settings.colorScheme in ['light', 'dark', 'system'])
        && (!('appThemeId' in request.resource.data.settings)
          || request.resource.data.settings.appThemeId in [
            'default', 'porcelain', 'ivory_dawn', 'coastal_mist',
            'obsidian', 'noir_harbor', 'ember_night',
          ])
        && (!('notificationsEnabled' in request.resource.data.settings)
          || request.resource.data.settings.notificationsEnabled is bool)
        && (!('soundEnabled' in request.resource.data.settings)
          || request.resource.data.settings.soundEnabled is bool)
        && (!('musicEnabled' in request.resource.data.settings)
          || request.resource.data.settings.musicEnabled is bool)
        && (!('hapticsEnabled' in request.resource.data.settings)
          || request.resource.data.settings.hapticsEnabled is bool)
        && (!('masterVolume' in request.resource.data.settings)
          || (request.resource.data.settings.masterVolume is number
            && request.resource.data.settings.masterVolume >= 0
            && request.resource.data.settings.masterVolume <= 1))
        && (!('musicVolume' in request.resource.data.settings)
          || (request.resource.data.settings.musicVolume is number
            && request.resource.data.settings.musicVolume >= 0
            && request.resource.data.settings.musicVolume <= 1))
        && validOptionalEquippedId(request.resource.data.settings, 'equippedEventSkinId')
        && validOptionalEquippedId(request.resource.data.settings, 'equippedNameFontId')
        && validOptionalEquippedId(request.resource.data.settings, 'equippedSoundPackId')
        && validOptionalEquippedId(request.resource.data.settings, 'equippedProfileFrameId')
        && validOptionalEquippedId(request.resource.data.settings, 'equippedTombstoneId');
    }

    function profileCreatedAtImmutable() {
      return !('profile' in resource.data)
        || !('profile' in request.resource.data)
        || request.resource.data.profile.createdAt == resource.data.profile.createdAt;
    }

    function profileOnlyWrite() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile'])
        && validProfile()
        && profileCreatedAtImmutable();
    }

    function settingsOnlyWrite() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings'])
        && validSettings();
    }

    function safeCreateEntitlements() {
      return request.resource.data.get('isPremium', false) == false
        && request.resource.data.get('hasNoAds', false) == false
        && request.resource.data.get('hasSeasonPass', false) == false
        && request.resource.data.get('unlockedAvatarStyles', []) == [];
    }

    function noPositiveGrants() {
      return (!('coinsGrant' in request.resource.data)
          || (request.resource.data.coinsGrant is number && request.resource.data.coinsGrant <= 0))
        && (!('gemsGrant' in request.resource.data)
          || (request.resource.data.gemsGrant is number && request.resource.data.gemsGrant <= 0))
        && (!('luckBoostGrant' in request.resource.data)
          || (request.resource.data.luckBoostGrant is number && request.resource.data.luckBoostGrant <= 0))
        && request.resource.data.get('reincarnationScroll', false) == false;
    }

    function entitlementsImmutable() {
      return request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false)
        && request.resource.data.get('hasNoAds', false) == resource.data.get('hasNoAds', false)
        && request.resource.data.get('hasSeasonPass', false) == resource.data.get('hasSeasonPass', false)
        && request.resource.data.get('unlockedAvatarStyles', [])
          == resource.data.get('unlockedAvatarStyles', []);
    }

    function onlyClientAllowedKeysChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(clientAllowedUserKeys());
    }

    function safeUserCreate() {
      return (
        (request.resource.data.keys().hasOnly(['profile']) && validProfile())
        || (
          request.resource.data.keys().hasOnly(clientAllowedUserKeys())
          && safeCreateEntitlements()
          && noPositiveGrants()
          && (!('settings' in request.resource.data) || validSettings())
        )
      );
    }

    function safeUserUpdate() {
      return (
        profileOnlyWrite()
        || settingsOnlyWrite()
        || (
          onlyClientAllowedKeysChanged()
          && entitlementsImmutable()
          && noPositiveGrants()
          && profileCreatedAtImmutable()
          && (!('settings' in request.resource.data) || validSettings())
        )
      );
    }

    function validSaveSlot() {
      return request.resource.data.keys().hasOnly([
          'character', 'updatedAt', 'updatedAtServer', 'lastSaved',
          'version', 'checksum', 'name', 'age', 'isAlive',
        ])
        && request.resource.data.character is map
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string
            && request.resource.data.name.size() <= 64))
        && (!('age' in request.resource.data)
          || (request.resource.data.age is number
            && request.resource.data.age >= 0
            && request.resource.data.age <= 200))
        && (!('isAlive' in request.resource.data)
          || request.resource.data.isAlive is bool)
        && (!('checksum' in request.resource.data)
          || (request.resource.data.checksum is string
            && request.resource.data.checksum.size() <= 128))
        && (!('version' in request.resource.data)
          || (request.resource.data.version is number
            && request.resource.data.version >= 0
            && request.resource.data.version <= 1000))
        && (!('updatedAt' in request.resource.data)
          || (request.resource.data.updatedAt is number
            && request.resource.data.updatedAt >= 0));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && safeUserCreate();
      allow update: if isOwner(uid) && safeUserUpdate();
      allow delete: if false;

      match /purchases/{transactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /saves/{uid}/slots/{slotId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSaveSlot();
      allow delete: if isOwner(uid);
    }

    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /entries/{entryUid} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /liveops/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /liveops_history/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
