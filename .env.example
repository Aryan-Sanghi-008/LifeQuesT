# Copy to .env and fill with your Firebase / AdMob / Google OAuth values.
# Never commit .env with real secrets.

# Firebase (Web app config from Firebase Console)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In — Web client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (for Google Sign-In URL scheme in app.config.ts)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Legal — public URLs (required for Play Store / App Store)
# Deploy hosting/public via: npm run deploy:hosting
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# Storage — MMKV is off by default on Android release builds (use AsyncStorage).
# Set to true after validating MMKV on your target devices.
# EXPO_PUBLIC_USE_MMKV=true

# AdMob — replace test IDs for production (from AdMob console)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712

# ─── EAS environment (cloud builds) ─────────────────────────────────────────
# Upload google-services.json (repeat --environment per profile):
#   eas env:create --scope project --name GOOGLE_SERVICES_JSON --type file \
#     --value ./google-services.json \
#     --environment development --environment preview --environment production \
#     --visibility secret
#
# Set EXPO_PUBLIC_* strings on EAS for preview/production:
#   eas env:create --scope project --name EXPO_PUBLIC_ADMOB_ANDROID_APP_ID \
#     --value "ca-app-pub-XXXXXXXX~YYYYYYYY" --environment production

# ─── Firebase Functions secrets (after Play Console is ready) ─────────────────
#   firebase functions:secrets:set GOOGLE_PLAY_PACKAGE_NAME
#   firebase functions:secrets:set GOOGLE_PLAY_SERVICE_ACCOUNT
#   firebase deploy --only functions
#
# Dev emulator only (never in production):
#   IAP_ALLOW_UNVERIFIED=true
#
# ─── Firebase Functions secrets (future iOS release) ─────────────────────────
#   firebase functions:secrets:set APPLE_ISSUER_ID
#   firebase functions:secrets:set APPLE_KEY_ID
#   firebase functions:secrets:set APPLE_BUNDLE_ID
#   firebase functions:secrets:set APPLE_PRIVATE_KEY
#   firebase deploy --only functions
