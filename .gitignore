# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
#
# Committed on purpose (do NOT add here):
#   src/, App.tsx, docs/workflows/, docs/ai-bootstrap/, jest.config.js,
#   CLAUDE.md, AGENTS.md, .env.example, package-lock.json

# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/
functions/node_modules/

# ─── Expo / React Native ────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Generated native projects (use `npx expo prebuild` locally)
/ios/
/android/

# ─── Secrets & local config ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# Firebase client configs (download from Firebase Console per developer)
google-services.json
GoogleService-Info.plist

# Firebase Admin / service accounts — never commit
*-firebase-adminsdk-*.json
serviceAccount*.json
firebase-service-account.json

# EAS / signing credentials
credentials.json
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ─── Firebase tooling ───────────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log

# ─── Cloud Functions build output ───────────────────────────────────────────
functions/lib/

# ─── Metro / bundler ────────────────────────────────────────────────────────
.metro-health-check*

# ─── Build artifacts ────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
build/
*.tsbuildinfo
eas-build-*.tar.gz

# ─── Native tooling ─────────────────────────────────────────────────────────
.kotlin/
*.orig
*.orig.*
*.hprof
local.properties
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/

# ─── Testing & coverage ─────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Logs & debug ───────────────────────────────────────────────────────────
*.log
logs/
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# ─── OS junk ────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
Desktop.ini

# ─── Editors ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Local AI config (installed via docs/ai-bootstrap/setup.sh) ───────────────
# Templates live in docs/ai-bootstrap/ — commit those, not live installs.
.cursor/
.claude/

# ─── Optional local git hooks (from docs/ai-bootstrap/setup.sh) ───────────────
.husky/

# ─── Misc caches & temp ───────────────────────────────────────────────────────
.cache/
.tmp/
tmp/
temp/
*.tmp
.watchmanconfig
