{
  "name": "LifeQuest",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "test": "jest --watchman=false",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "validate": "npm run type-check && npm run lint && npm test",
    "check:deps": "depcheck",
    "deploy:backend": "firebase deploy --only firestore:rules,functions",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@iaptic/react-native-iap": "^13.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^23.8.8",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/crashlytics": "^23.8.8",
    "@react-native-google-signin/google-signin": "^11.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "babel-preset-expo": "~56.0.0",
    "expo": "~56.0.12",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.7",
    "expo-haptics": "^56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-notifications": "^0.32.17",
    "expo-splash-screen": "~56.0.10",
    "firebase": "^12.15.0",
    "immer": "^10.1.1",
    "jest-expo": "~56.0.5",
    "nativewind": "^4.0.36",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.4",
    "react-native-mmkv": "^2.12.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/eslint-config": "0.73.2",
    "@types/jest": "~29.5.14",
    "@types/node": "^22.20.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "depcheck": "^1.4.7",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "depcheck": {
    "ignores": [
      "babel-preset-expo",
      "babel-plugin-module-resolver",
      "expo-dev-client",
      "nativewind",
      "tailwindcss",
      "react-native-reanimated",
      "react-native-worklets",
      "@babel/core",
      "@types/jest"
    ],
    "ignorePatterns": [
      "docs/**",
      "functions/lib/**"
    ],
    "skipMissing": true,
    "parsers": {
      "**/*.{ts,tsx}": "typescript",
      "**/*.js": "es6"
    }
  }
}
